# Environment Variables Template for TaskFlow Application
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials to version control!

# ========================================
# AWS Configuration
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ========================================
# Docker Hub Configuration
# ========================================
DOCKER_HUB_USERNAME=your_dockerhub_username
DOCKER_HUB_PASSWORD=your_dockerhub_password_or_token
DOCKER_HUB_REPO=your_dockerhub_username/taskflow

# ========================================
# Application Configuration
# ========================================
# MongoDB connection string
MONGO_URI=mongodb://mongo:27017/tms

# JWT secret for authentication (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Application port
PORT=5000

# Node environment
NODE_ENV=production

# ========================================
# Frontend Configuration
# ========================================
# Backend API URL (will be the EC2 public IP)
REACT_APP_API_URL=http://your-ec2-ip:5000

# ========================================
# EC2 Configuration
# ========================================
EC2_PUBLIC_IP=will-be-generated-by-terraform
EC2_INSTANCE_TYPE=t3.micro
EC2_KEY_NAME=taskflow-backend-key

# ========================================
# S3 Configuration
# ========================================
S3_BUCKET_NAME=your-unique-bucket-name-2026

# ========================================
# Build Configuration
# ========================================
IMAGE_TAG=latest
BUILD_NUMBER=1

# ========================================
# Jenkins Configuration (Optional)
# ========================================
JENKINS_URL=http://your-jenkins-ip:8080
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token

# ========================================
# Monitoring & Logging (Optional)
# ========================================
LOG_LEVEL=info
ENABLE_METRICS=true

# ========================================
# Security Settings
# ========================================
# Enable CORS for these origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://your-ec2-ip:3000

# Session secret for production
SESSION_SECRET=your-session-secret-change-this

# ========================================
# Database Backup (Optional)
# ========================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_S3_BUCKET=your-backup-bucket-name

# ========================================
# Notes:
# ========================================
# 1. Generate strong random secrets using: openssl rand -base64 32
# 2. Never commit this file with real values to git
# 3. Add .env to .gitignore
# 4. For Docker Hub token: https://hub.docker.com/settings/security
# 5. For AWS credentials: Use IAM with minimal required permissions
# 6. Consider using AWS Secrets Manager or HashiCorp Vault in production
